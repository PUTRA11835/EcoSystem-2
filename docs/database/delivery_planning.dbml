
Project DeliveryPlanning {
  database_type: 'MySQL'
  Note: '''
    # Delivery Planning System

    Struktur hierarki yang didukung:
    - Phase → Group → Stage → Activity
    - Phase → Group → Activity (tanpa Stage)

    Fitur utama:
    - Sub-group unlimited level
    - Activity bisa langsung di Group
    - Employee assignment dengan role
  '''
}

// ============================================================================
// CORE TABLES
// ============================================================================

Table projects {
  id bigint [pk, increment]
  name varchar(255) [not null]
  code varchar(50)
  description text
  customer_id bigint
  status enum('draft','planning','active','on_hold','completed','cancelled')
  start_date date
  end_date date
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  Note: 'Master table untuk project'
}

Table employee {
  employee_id bigint [pk, increment]
  full_name varchar(255)
  email varchar(255)
  position varchar(100)
  department varchar(100)
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp

  Note: 'Master table untuk employee'
}

// ============================================================================
// DELIVERY PHASES
// ============================================================================

Table delivery_phases {
  id bigint [pk, increment]
  name varchar(255) [not null]
  code varchar(20) [note: 'Kode singkat: PLAN, DEV, UAT, dll']
  description text
  color varchar(7) [default: '#3B82F6', note: 'Hex color']
  icon varchar(50)
  order_sequence int [default: 0]
  orientation enum('vertical','horizontal') [default: 'vertical']
  is_system_default boolean [default: false, note: 'Template bawaan sistem']
  is_optional boolean [default: false]
  is_active boolean [default: true]
  parent_phase_id bigint [ref: > delivery_phases.id, note: 'Self-ref untuk nested']
  settings json [note: 'Custom settings JSON']
  metadata json
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    is_active [name: 'idx_phase_active']
    is_system_default [name: 'idx_phase_default']
    (is_active, order_sequence) [name: 'idx_phase_order']
  }

  Note: 'Template fase yang bisa dipakai ulang di berbagai project'
}

Table project_delivery_phases {
  id bigint [pk, increment]
  project_id bigint [ref: > projects.id, not null]
  delivery_phase_id bigint [ref: > delivery_phases.id, not null]
  weight decimal(5,2) [default: 0, note: 'Bobot fase dalam project']
  order_sequence int [default: 0]
  is_visible boolean [default: true]
  is_golive_phase boolean [default: false]
  orientation enum('vertical','horizontal') [default: 'vertical']
  custom_settings json
  calculated_progress decimal(5,2) [default: 0]
  calculated_start_date date
  calculated_end_date date
  created_at timestamp
  updated_at timestamp

  indexes {
    (project_id, delivery_phase_id) [unique, name: 'unique_project_phase']
    (project_id, is_visible, order_sequence) [name: 'idx_project_phases_display']
  }

  Note: 'Junction table: konfigurasi fase per-project'
}

// ============================================================================
// DELIVERY GROUPS (dengan Sub-group)
// ============================================================================

Table delivery_groups {
  id bigint [pk, increment]
  project_id bigint [ref: > projects.id, not null]
  phase_id bigint [ref: > delivery_phases.id]
  project_phase_id bigint [ref: > project_delivery_phases.id]
  parent_id bigint [ref: > delivery_groups.id, note: 'Self-ref untuk sub-group']
  name varchar(255) [not null]
  code varchar(30)
  description text
  level int [default: 0, note: '0=root, 1=child, dst']
  order_sequence int [default: 0]
  path varchar(500) [note: 'Materialized path: 1/5/12/']
  start_date date
  end_date date
  actual_start_date date
  actual_end_date date
  weight decimal(5,2) [default: 0]
  status enum('not_started','in_progress','completed','delayed','on_hold') [default: 'not_started']
  progress_percentage decimal(5,2) [default: 0]
  color varchar(7)
  icon varchar(50)
  notes text
  settings json
  metadata json
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    (project_id, phase_id, parent_id) [name: 'idx_group_hierarchy']
    (project_id, level, order_sequence) [name: 'idx_group_level']
    (project_id, status) [name: 'idx_group_status']
    path [name: 'idx_group_path']
  }

  Note: 'Grup dalam fase, mendukung sub-group unlimited level'
}

// ============================================================================
// DELIVERY STAGES (Optional)
// ============================================================================

Table delivery_stages {
  id bigint [pk, increment]
  group_id bigint [ref: > delivery_groups.id, not null]
  project_id bigint [ref: > projects.id, not null]
  name varchar(255) [not null]
  code varchar(30)
  description text
  order_sequence int [default: 0]
  color varchar(7)
  planned_start_date date
  planned_end_date date
  actual_start_date date
  actual_end_date date
  weight decimal(5,2) [default: 0]
  status enum('not_started','in_progress','completed','delayed','on_hold') [default: 'not_started']
  progress decimal(5,2) [default: 0]
  custom_fields json
  metadata json
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    (group_id, order_sequence) [name: 'idx_stage_order']
    (project_id, status) [name: 'idx_stage_status']
  }

  Note: 'Tahapan dalam grup (OPTIONAL - activity bisa langsung di grup)'
}

// ============================================================================
// DELIVERY ACTIVITIES (Flexible Parent)
// ============================================================================

Table delivery_activities {
  id bigint [pk, increment]
  project_id bigint [ref: > projects.id, not null]
  phase_id bigint [ref: > delivery_phases.id]
  parent_type enum('stage','group') [default: 'stage', note: 'Menentukan parent']
  stage_id bigint [ref: > delivery_stages.id, note: 'Jika parent_type=stage']
  group_id bigint [ref: > delivery_groups.id, note: 'Jika parent_type=group']
  name varchar(255) [not null]
  code varchar(50)
  description text
  order_sequence int [default: 0]
  module varchar(100) [note: 'SAP Module: FI, CO, MM, SD']
  tcode varchar(50) [note: 'Transaction Code']
  complexity enum('low','medium','high','very_high')
  receive_type varchar(50)
  new_requirement boolean [default: false]
  functional_sinergi text
  technical_sinergi text
  deliverable text
  start_date date
  end_date date
  actual_start_date date
  actual_end_date date
  weight decimal(5,2) [default: 0]
  status enum('not_started','in_progress','completed','delayed','on_hold','cancelled') [default: 'not_started']
  progress_percentage decimal(5,2) [default: 0]
  notes text
  acceptance_criteria text
  custom_fields json
  metadata json
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    (project_id, phase_id) [name: 'idx_activity_project_phase']
    (stage_id, order_sequence) [name: 'idx_activity_stage']
    (group_id, order_sequence) [name: 'idx_activity_group']
    (project_id, status) [name: 'idx_activity_status']
    (project_id, parent_type, status) [name: 'idx_activity_parent_type']
    (parent_type, stage_id, group_id) [name: 'idx_activity_parent']
  }

  Note: 'Aktivitas dengan flexible parent (Stage atau Group langsung)'
}

// ============================================================================
// EMPLOYEE ASSIGNMENT
// ============================================================================

Table delivery_activity_employees {
  id bigint [pk, increment]
  activity_id bigint [ref: > delivery_activities.id, not null]
  employee_id bigint [ref: > employee.employee_id, not null]
  role enum('lead','member','reviewer','support','observer') [default: 'member']
  allocation_percentage decimal(5,2) [default: 100, note: '% alokasi waktu']
  assigned_date date
  start_date date
  end_date date
  is_active boolean [default: true]
  notes text
  created_at timestamp
  updated_at timestamp

  indexes {
    (activity_id, employee_id) [unique, name: 'unique_activity_employee']
    (employee_id, is_active) [name: 'idx_employee_assignments']
  }

  Note: 'Assignment karyawan ke aktivitas (Many-to-Many)'
}

// ============================================================================
// VIEW CONFIGURATIONS
// ============================================================================

Table delivery_view_configurations {
  id bigint [pk, increment]
  project_id bigint [ref: > projects.id, not null]
  user_id bigint
  default_view enum('table','gantt','scurve','kanban') [default: 'table']
  visible_phases json [note: 'Array of visible phase IDs']
  collapsed_groups json [note: 'Array of collapsed group IDs']
  column_settings json [note: 'Table column visibility/order']
  filters json [note: 'Saved filter settings']
  created_at timestamp
  updated_at timestamp

  indexes {
    (project_id, user_id) [unique, name: 'unique_user_view_config']
  }

  Note: 'Preferensi tampilan user per project'
}

// ============================================================================
// RELATIONSHIP NOTES
// ============================================================================

// Phase Hierarchy:
// delivery_phases (Template)
//   └── project_delivery_phases (Config per Project)
//         └── delivery_groups (bisa nested unlimited)
//               ├── delivery_stages (OPTIONAL)
//               │     └── delivery_activities (parent_type='stage')
//               └── delivery_activities (parent_type='group') [DIRECT!]

// Sub-group Pattern:
// delivery_groups.parent_id -> delivery_groups.id (self-reference)
// Menggunakan materialized path untuk query cepat

// Flexible Activity Parent:
// Jika parent_type = 'stage' -> gunakan stage_id
// Jika parent_type = 'group' -> gunakan group_id (tanpa stage!)
