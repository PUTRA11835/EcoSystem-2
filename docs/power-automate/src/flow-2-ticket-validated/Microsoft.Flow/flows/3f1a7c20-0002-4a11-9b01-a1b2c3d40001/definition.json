{
    "name": "3f1a7c20-0002-4a11-9b01-a1b2c3d40001",
    "id": "/providers/Microsoft.Flow/flows/3f1a7c20-0002-4a11-9b01-a1b2c3d40001",
    "type": "Microsoft.Flow/flows",
    "properties": {
        "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
        "displayName": "EcoSystem - Ticket Validated",
        "definition": {
            "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
            "contentVersion": "1.0.0.0",
            "parameters": {
                "$connections": {
                    "defaultValue": {},
                    "type": "Object"
                },
                "$authentication": {
                    "defaultValue": {},
                    "type": "SecureObject"
                }
            },
            "triggers": {
                "manual": {
                    "type": "Request",
                    "kind": "Http",
                    "inputs": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "event": {
                                    "type": "string"
                                },
                                "sent_at": {
                                    "type": "string"
                                },
                                "source": {
                                    "type": "string"
                                },
                                "ticket": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "number": {
                                            "type": "string"
                                        },
                                        "subject": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "status": {
                                            "type": "string"
                                        },
                                        "status_label": {
                                            "type": "string"
                                        },
                                        "priority": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "type": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "scale": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "channel": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "customer": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "end_customer": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "module": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "module_id": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ]
                                        },
                                        "submitted_by": {
                                            "type": "object",
                                            "properties": {
                                                "name": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "email": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "phone": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                }
                                            }
                                        },
                                        "pic": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "members": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "is_assigned": {
                                            "type": "boolean"
                                        },
                                        "created_at": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "age_minutes": {
                                            "type": "integer"
                                        },
                                        "url": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "module_leads": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "employee_id": {
                                                "type": "integer"
                                            },
                                            "name": {
                                                "type": [
                                                    "string",
                                                    "null"
                                                ]
                                            },
                                            "email": {
                                                "type": [
                                                    "string",
                                                    "null"
                                                ]
                                            }
                                        }
                                    }
                                },
                                "lead_emails": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "validated_by": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ]
                                        },
                                        "name": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    }
                                }
                            }
                        },
                        "method": "POST"
                    }
                }
            },
            "actions": {
                "Cek_secret_EcoSystem": {
                    "type": "If",
                    "expression": {
                        "equals": [
                            "@triggerOutputs()?['headers']?['X-EcoSystem-Secret']",
                            "GANTI_DENGAN_POWER_AUTOMATE_SECRET"
                        ]
                    },
                    "actions": {
                        "Kartu_tiket_ke_channel": {
                            "type": "OpenApiConnection",
                            "inputs": {
                                "host": {
                                    "connectionName": "shared_teams",
                                    "operationId": "PostCardToConversation",
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                                },
                                "parameters": {
                                    "poster": "Flow bot",
                                    "location": "Channel",
                                    "body/recipient/groupId": "",
                                    "body/recipient/channelId": "",
                                    "body/messageBody": "{\n    \"type\": \"AdaptiveCard\",\n    \"$schema\": \"http://adaptivecards.io/schemas/adaptive-card.json\",\n    \"version\": \"1.4\",\n    \"body\": [\n        {\n            \"type\": \"TextBlock\",\n            \"text\": \"Tiket Baru: @{triggerBody()?['ticket']?['number']}\",\n            \"weight\": \"Bolder\",\n            \"size\": \"Large\",\n            \"wrap\": true\n        },\n        {\n            \"type\": \"TextBlock\",\n            \"text\": \"@{triggerBody()?['ticket']?['subject']}\",\n            \"wrap\": true,\n            \"spacing\": \"None\"\n        },\n        {\n            \"type\": \"FactSet\",\n            \"facts\": [\n                {\n                    \"title\": \"Customer\",\n                    \"value\": \"@{coalesce(triggerBody()?['ticket']?['customer'], '-')}\"\n                },\n                {\n                    \"title\": \"Modul\",\n                    \"value\": \"@{coalesce(triggerBody()?['ticket']?['module'], 'Belum ditentukan')}\"\n                },\n                {\n                    \"title\": \"Prioritas\",\n                    \"value\": \"@{coalesce(triggerBody()?['ticket']?['priority'], '-')}\"\n                },\n                {\n                    \"title\": \"Tipe\",\n                    \"value\": \"@{coalesce(triggerBody()?['ticket']?['type'], '-')}\"\n                },\n                {\n                    \"title\": \"Pelapor\",\n                    \"value\": \"@{coalesce(triggerBody()?['ticket']?['submitted_by']?['name'], '-')}\"\n                },\n                {\n                    \"title\": \"Divalidasi oleh\",\n                    \"value\": \"@{coalesce(triggerBody()?['validated_by']?['name'], '-')}\"\n                },\n                {\n                    \"title\": \"Lead Modul\",\n                    \"value\": \"@{if(empty(triggerBody()?['lead_emails']), 'Belum ada lead', join(triggerBody()?['lead_emails'], ', '))}\"\n                }\n            ]\n        }\n    ],\n    \"actions\": [\n        {\n            \"type\": \"Action.OpenUrl\",\n            \"title\": \"Buka di EcoSystem\",\n            \"url\": \"@{triggerBody()?['ticket']?['url']}\"\n        }\n    ]\n}"
                                },
                                "authentication": "@parameters('$authentication')"
                            },
                            "runAfter": {}
                        },
                        "Untuk_setiap_lead_modul": {
                            "type": "Foreach",
                            "foreach": "@triggerBody()?['lead_emails']",
                            "actions": {
                                "Kartu_tiket_ke_chat_lead": {
                                    "type": "OpenApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connectionName": "shared_teams",
                                            "operationId": "PostCardToConversation",
                                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                                        },
                                        "parameters": {
                                            "poster": "Flow bot",
                                            "location": "Chat with Flow bot",
                                            "body/recipient/to": "@items('Untuk_setiap_lead_modul')",
                                            "body/messageBody": "{\n    \"type\": \"AdaptiveCard\",\n    \"$schema\": \"http://adaptivecards.io/schemas/adaptive-card.json\",\n    \"version\": \"1.4\",\n    \"body\": [\n        {\n            \"type\": \"TextBlock\",\n            \"text\": \"Tiket baru di modul Anda\",\n            \"weight\": \"Bolder\",\n            \"size\": \"Medium\"\n        },\n        {\n            \"type\": \"TextBlock\",\n            \"text\": \"**@{triggerBody()?['ticket']?['number']}** - @{triggerBody()?['ticket']?['subject']}\",\n            \"wrap\": true\n        },\n        {\n            \"type\": \"FactSet\",\n            \"facts\": [\n                {\n                    \"title\": \"Customer\",\n                    \"value\": \"@{coalesce(triggerBody()?['ticket']?['customer'], '-')}\"\n                },\n                {\n                    \"title\": \"Modul\",\n                    \"value\": \"@{coalesce(triggerBody()?['ticket']?['module'], '-')}\"\n                },\n                {\n                    \"title\": \"Prioritas\",\n                    \"value\": \"@{coalesce(triggerBody()?['ticket']?['priority'], '-')}\"\n                }\n            ]\n        },\n        {\n            \"type\": \"TextBlock\",\n            \"text\": \"Mohon tentukan PIC atau ambil tiket ini.\",\n            \"wrap\": true\n        }\n    ],\n    \"actions\": [\n        {\n            \"type\": \"Action.OpenUrl\",\n            \"title\": \"Assign / Ambil Tiket\",\n            \"url\": \"@{triggerBody()?['ticket']?['url']}\"\n        }\n    ]\n}"
                                        },
                                        "authentication": "@parameters('$authentication')"
                                    },
                                    "runAfter": {}
                                }
                            },
                            "runAfter": {
                                "Kartu_tiket_ke_channel": [
                                    "Succeeded"
                                ]
                            }
                        }
                    },
                    "else": {
                        "actions": {
                            "Hentikan_secret_tidak_cocok": {
                                "type": "Terminate",
                                "inputs": {
                                    "runStatus": "Cancelled"
                                },
                                "runAfter": {}
                            }
                        }
                    },
                    "runAfter": {}
                }
            },
            "outputs": {}
        },
        "connectionReferences": {
            "shared_teams": {
                "connectionName": "shared_teams",
                "source": "Embedded",
                "id": "/providers/Microsoft.PowerApps/apis/shared_teams",
                "tier": "NotSpecified"
            }
        },
        "flowFailureAlertSubscribed": false
    },
    "schemaVersion": "1.0.0.0"
}