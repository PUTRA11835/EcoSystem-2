{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.4",
    "body": [
        {
            "type": "TextBlock",
            "text": "Tiket baru",
            "weight": "Bolder",
            "size": "Medium"
        },
        {
            "type": "TextBlock",
            "text": "**@{triggerBody()?['ticket']?['number']}** - @{triggerBody()?['ticket']?['subject']}",
            "wrap": true
        },
        {
            "type": "FactSet",
            "facts": [
                {
                    "title": "Customer",
                    "value": "@{coalesce(triggerBody()?['ticket']?['customer'], '-')}"
                },
                {
                    "title": "Modul",
                    "value": "@{coalesce(triggerBody()?['ticket']?['module'], '-')}"
                },
                {
                    "title": "Prioritas",
                    "value": "@{coalesce(triggerBody()?['ticket']?['priority'], '-')}"
                },
                {
                    "title": "No HP",
                    "value": "@{if(empty(triggerBody()?['ticket']?['submitted_by']?['phone']), '-', triggerBody()?['ticket']?['submitted_by']?['phone'])}"
                },
                {
                    "title": "Delivery Support",
                    "value": "@{if(empty(triggerBody()?['delivery_support']?['name']), '-', triggerBody()?['delivery_support']?['name'])}"
                },
                {
                    "title": "Tim Support",
                    "value": "@{if(empty(triggerBody()?['delivery_support']?['team_csv']), '-', triggerBody()?['delivery_support']?['team_csv'])}"
                }
            ]
        },
        {
            "type": "TextBlock",
            "text": "Mohon tentukan PIC atau ambil tiket ini.",
            "wrap": true
        }
    ],
    "actions": [
        {
            "type": "Action.OpenUrl",
            "title": "Assign / Ambil Tiket",
            "url": "@{triggerBody()?['ticket']?['url']}"
        }
    ]
}
