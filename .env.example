APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# === PRODUCTION (HTTPS) ===
# Di server produksi, set tiga nilai ini:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://domain-anda.com -> WAJIB https, tanpa trailing slash
# AppServiceProvider memaksa URL::forceScheme('https') bila APP_URL berskema
# https:// -> route()/url()/asset() dijamin menghasilkan https tanpa bergantung
# pada apakah reverse proxy meneruskan header X-Forwarded-Proto. Ini mencegah
# Mixed Content (mis. action <form> http:// -> "form not secure" di browser).
# Setelah ubah env di produksi, WAJIB: php artisan optimize:clear

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi (HTTPS): set true agar cookie sesi/auth hanya dikirim lewat koneksi aman.
# JANGAN true di lokal http -> login akan gagal karena cookie tak terkirim.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# HARUS lebih besar dari --timeout worker terpanjang (queue-worker-reports = 900,
# lihat docker/supervisord.conf). Kalau lebih kecil, job panjang (Word Report
# Generator, 5-10 menit) dianggap nyangkut lalu diproses ULANG saat yang asli
# masih jalan -> laporan ke-generate berkali-kali, rate limit AI meledak.
DB_QUEUE_RETRY_AFTER=1800

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Microsoft Graph API (wajib diisi di server)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Jarvies integration
JARVIES_URL=
JARVIES_API_KEY=
EXTERNAL_TICKET_API_KEY=

# CORS — origin (HTTPS) yang boleh memanggil API (Jarvies/mobile), pisahkan dgn koma.
# Contoh produksi: https://jarvies.domain-anda.com
# Default (kosong) -> fallback ke origin dev lokal di config/cors.php.
CORS_ALLOWED_ORIGINS=

# Anthropic (Claude) — dipakai AI Assistant & AI Research
ANTHROPIC_API_KEY=

# Skill ID Agent Skills custom "sap-ticket-analyzer" (dibuat di Anthropic Console)
# — dipakai fitur Analisa AI di validasi Staging Ticket.
ANTHROPIC_TICKET_ANALYZER_SKILL_ID=

# Skill ID Agent Skills custom "laravel-word-report-generator" — isi otomatis
# setelah menjalankan `php artisan claude:upload-skill` (lihat output command-nya).
ANTHROPIC_WORD_REPORT_SKILL_ID=

# OpenAI (GPT) — dipilih per asisten lewat Control Center → AI Settings.
# WAJIB diisi pada instalasi baru: bawaan asisten "AI Summarize (Daftar Tiket)"
# dan "Word Report Generator (Susun Dokumen)" memakai model gpt-5.6-*, jadi
# tanpa kunci ini kedua fitur itu gagal walau ANTHROPIC_API_KEY sudah terisi.
OPENAI_API_KEY=

# Berapa hari riwayat percakapan AI disimpan (dihitung dari pesan terakhir).
# 0 = simpan selamanya. Pembersihannya jalan tiap hari 03:00 lewat ai:prune-conversations.
AI_HISTORY_RETENTION_DAYS=90

# ==================== POWER AUTOMATE (Microsoft Teams) ====================
# EcoSystem yang MEMANGGIL Power Automate. Tiap flow dibuat dengan trigger
# "When an HTTP request is received" (konektor standard, bukan premium), lalu
# URL HTTP POST-nya disalin ke variabel di bawah. Flow yang URL-nya dikosongkan
# otomatis dilewati, jadi ketiganya bisa dinyalakan bertahap.
# Panduan lengkap pembuatan flow: docs/power-automate-integration.md
POWER_AUTOMATE_ENABLED=false

# Rahasia bersama, dikirim sebagai header X-EcoSystem-Secret dan dicek oleh
# tiap flow lewat Condition. Bangkitkan acak, mis. `php artisan tinker` ->
# Str::random(48). Nilainya harus sama persis di sini dan di flow.
POWER_AUTOMATE_SECRET=

# Detik menunggu balasan flow sebelum menyerah.
POWER_AUTOMATE_TIMEOUT=10

# --- PAGAR STAGING -----------------------------------------------------------
# Email pelapor yang BOLEH memicu Power Automate (pisah koma).
#
# KOSONG = tanpa batas. Itu keadaan PRODUKSI, dan sengaja jadi default supaya
# lupa mengisinya tidak pernah membisukan notifikasi customer sungguhan.
#
# DIISI HANYA DI SERVER DEV/STAGING. Staging membaca mailbox
# support@eclectic.co.id yang SAMA dengan produksi, jadi tanpa pagar ini email
# customer sungguhan yang kebetulan masuk saat demo akan memicu group chat Teams
# dan notifikasi ke employee sungguhan -- dari server yang datanya belum tentu benar.
#
# Payload yang email pelapornya tidak dikenali ikut DIHADANG, bukan diloloskan.
# Contoh isi di staging:
#   POWER_AUTOMATE_ALLOWED_SUBMITTERS=putrapalampangt@gmail.com
POWER_AUTOMATE_ALLOWED_SUBMITTERS=

# URL trigger tiap flow (kosong = fitur itu mati)
POWER_AUTOMATE_FLOW_EMAIL_RECEIVED=
POWER_AUTOMATE_FLOW_TICKET_VALIDATED=
POWER_AUTOMATE_FLOW_TICKET_OPEN_REMINDER=
POWER_AUTOMATE_FLOW_TICKET_MEMBER_ADDED=

# Flow 7 -- internal note EcoSystem dikirim ke group chat tiket. Ini satu-satunya
# jalan keluar ke Teams: POST /chats/{id}/messages TIDAK bisa app-only lewat Graph.
POWER_AUTOMATE_FLOW_TEAMS_POST_MESSAGE=

# ─── Sinkronisasi chat Teams <-> internal note ────────────────────────────────
# Rancangan lengkap: docs/teams-chat-sync-design.md
#
# Semua default MATI. Dua arahnya bisa dinyalakan terpisah; mematikan keduanya
# mengembalikan sistem ke keadaan sebelum fitur ini ada, tanpa deploy ulang.
TEAMS_SYNC_ENABLED=false
TEAMS_SYNC_INBOUND=false
TEAMS_SYNC_OUTBOUND=false

# Pagar ledakan: maksimal pesan yang diserap per chat per putaran polling.
TEAMS_SYNC_MAX_PER_POLL=20
# Jumlah chat yang dipoll per putaran.
TEAMS_SYNC_CHAT_BATCH=50
# Polling gagal beruntun sebanyak ini -> sinkron chat itu dimatikan sendiri.
TEAMS_SYNC_MAX_POLL_FAILURES=10
TEAMS_SYNC_TIMEOUT=15

# Akun pemilik connection Teams di Power Automate. Kosong = pakai MS_SENDER_EMAIL.
# Dua perannya, keduanya muncul begitu chat dibuat lewat Graph:
#  1. WAJIB ikut jadi anggota tiap group chat buatan Graph -- Graph tidak
#     menambahkan siapa pun otomatis (konektor Teams dulu menambahkannya sendiri),
#     dan flow tidak bisa memposting ke grup yang akun koneksinya bukan anggota.
#  2. Pesannya DIABAIKAN saat sinkron masuk -- semua yang diposting flow (kartu
#     tiket, mention lead, dan internal note yang baru kita kirim sendiri) datang
#     atas nama akun ini. Tanpa itu, tiap note keluar tersimpan DOBEL di tiket.
POWER_AUTOMATE_TEAMS_CONNECTION_OWNER=

# Antrean kirim keluar.
TEAMS_SYNC_OUTBOX_BATCH=25
TEAMS_SYNC_OUTBOX_MAX_ATTEMPTS=5

# BIARKAN KOSONG. Kosong = memakai app registration email (MS_* di atas), sesuai
# keputusan 17 Sep 2026 -- satu secret, satu tanggal kedaluwarsa untuk dipantau.
# Isi hanya kalau Teams nanti dipindah ke app registration sendiri; kodenya tidak
# perlu berubah, cukup .env + php artisan optimize:clear.
MS_TEAMS_TENANT_ID=
MS_TEAMS_CLIENT_ID=
MS_TEAMS_CLIENT_SECRET=

# Anggota tetap group chat tiket di Teams (pisah koma). Gunanya menjamin chat
# berisi >= 3 orang (syarat Teams agar grup boleh diberi nama) dan tetap ada
# penerima saat modul tiket belum punya Module Lead. Boleh KOSONG selama
# POWER_AUTOMATE_TEAMS_MEMBER_ROLE_IDS masih mengisi grup dengan role penjaga.
# JANGAN diisi alamat pemilik koneksi Teams -- lihat _EXCLUDE_MEMBERS di bawah.
POWER_AUTOMATE_TEAMS_EXTRA_MEMBERS=

# Ikutkan email akun yang menvalidasi tiket sebagai anggota grup.
POWER_AUTOMATE_TEAMS_INCLUDE_VALIDATOR=true

# Alamat yang tidak pernah boleh dikirim ke Teams (pisah koma). Akun sistem
# seperti ECI_ADMIN punya email di database tapi bukan mailbox Microsoft 365,
# dan satu alamat asing membuat pembuatan grup gagal seluruhnya.
# Per 7 Sep 2026: ECI_ADMIN (admin@) dan ECSUPPORT01 (support01@) sama-sama
# punya email di database tapi bukan mailbox M365 -- alamat karangan.
# WAJIB memuat alamat pemilik KONEKSI Teams flow: akun koneksi otomatis jadi
# pembuat + peserta grup, dan kalau ia ikut lagi di daftar anggota, Create a
# chat gagal "Duplicate chat members" (terbukti 11 Sep 2026).
POWER_AUTOMATE_TEAMS_EXCLUDE_MEMBERS=admin@eclectic.co.id,support01@eclectic.co.id,support@eclectic.co.id

# role_id yang pemegangnya SELALU ikut ke tiap group chat tiket baru, di samping
# Module Lead (pisah koma). 5 = Delivery Support Head, 6 = Delivery Support
# Service Helpdesk. Kosongkan untuk mematikan penambahan berbasis role.
# Cek isi role: SELECT id, name FROM employee_role WHERE id IN (5,6);
POWER_AUTOMATE_TEAMS_MEMBER_ROLE_IDS=5,6

# Ikutkan tim Delivery Support tiket (Delivery Owner, Support Manager, CO PM,
# Support Admin) ke group chat. Orangnya diambil dari delivery support yang
# dipilih saat validasi, jadi berbeda per tiket.
POWER_AUTOMATE_TEAMS_INCLUDE_SUPPORT_TEAM=true

# Batas peserta satu group chat Teams (batas konektor = 20). Kelebihan peserta
# membuat aksi "Create a chat" gagal seluruhnya, jadi daftarnya dipotong lebih
# dulu — yang dibuang anggota tetap & role penjaga, bukan lead modul / tim
# Delivery Support. 0 = tanpa batas.
POWER_AUTOMATE_TEAMS_MAX_MEMBERS=20

# --- Reminder tiket berstatus open ---
# Jarak antar reminder untuk satu tiket yang sama (menit).
POWER_AUTOMATE_REMINDER_INTERVAL_MINUTES=60

# Batas jumlah reminder per tiket. 0 = tanpa batas (kirim terus selama open).
POWER_AUTOMATE_REMINDER_MAX_COUNT=0

# Maksimum tiket yang diproses per satu kali scheduler jalan — pagar ledakan
# supaya backlog tiket open lama tidak mengirim ratusan pesan Teams sekaligus.
POWER_AUTOMATE_REMINDER_BATCH_LIMIT=50

# Hanya tiket yang dibuat pada/setelah waktu ini yang direminder. WAJIB diisi
# waktu go-live fitur pada instalasi yang sudah punya tiket open lama.
# Kosong = seluruh tiket open ikut direminder.
POWER_AUTOMATE_REMINDER_SINCE=

# true = berhenti mengingatkan begitu tiket punya PIC atau member, walau
# statusnya masih open.
# Tipe tiket yang diingatkan (pisah koma). Kosong = semua tipe. Nilai sah:
# Incident, Change Request, Service Request, EWA, RISE, Consult, Internal.
# EWA/Consult/Internal umumnya tidak menuntut lead segera meng-assign orang.
POWER_AUTOMATE_REMINDER_TYPES=

POWER_AUTOMATE_REMINDER_STOP_WHEN_ASSIGNED=false
