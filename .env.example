APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# === PRODUCTION (HTTPS) ===
# Di server produksi, set tiga nilai ini:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://domain-anda.com -> WAJIB https, tanpa trailing slash
# AppServiceProvider memaksa URL::forceScheme('https') bila APP_URL berskema
# https:// -> route()/url()/asset() dijamin menghasilkan https tanpa bergantung
# pada apakah reverse proxy meneruskan header X-Forwarded-Proto. Ini mencegah
# Mixed Content (mis. action <form> http:// -> "form not secure" di browser).
# Setelah ubah env di produksi, WAJIB: php artisan optimize:clear

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi (HTTPS): set true agar cookie sesi/auth hanya dikirim lewat koneksi aman.
# JANGAN true di lokal http -> login akan gagal karena cookie tak terkirim.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Microsoft Graph API (wajib diisi di server)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Jarvies integration
JARVIES_URL=
JARVIES_API_KEY=
EXTERNAL_TICKET_API_KEY=

# CORS — origin (HTTPS) yang boleh memanggil API (Jarvies/mobile), pisahkan dgn koma.
# Contoh produksi: https://jarvies.domain-anda.com
# Default (kosong) -> fallback ke origin dev lokal di config/cors.php.
CORS_ALLOWED_ORIGINS=
